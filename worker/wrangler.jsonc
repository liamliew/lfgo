{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lfgo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Attach the Worker to the short domain. The zone (lfcrea.com) must be
  // active on your Cloudflare account. Cloudflare creates the DNS record
  // and certificate for you; there must be no existing CNAME for "go".
  "routes": [{ "pattern": "go.lfcrea.com", "custom_domain": true }],

  // Binding with no id: `wrangler deploy` provisions the namespace and
  // writes the id back here. Or create one yourself and add "id".
  "kv_namespaces": [{ "binding": "LINKS" }],

  "vars": {
    // Public base used to build `shortUrl` in API responses.
    "SHORT_BASE_URL": "https://go.lfcrea.com",
    // Comma-separated browser origins allowed to call /api/*. Add your
    // extension as chrome-extension://<extension-id>. The wacrm server
    // calls the API server-side, so it does not need to be listed.
    "ALLOWED_ORIGINS": ""
  }

  // The API_KEY secret is set with `wrangler secret put API_KEY` (see
  // README). Until it exists, every /api/* call returns 500 (fails closed).
}
