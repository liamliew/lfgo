{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lfgo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Attach the Worker to the short domain. The zone (lfcrea.com) must be
  // active on your Cloudflare account. Cloudflare creates the DNS record
  // and certificate for you; there must be no existing CNAME for "go".
  "routes": [{ "pattern": "go.lfcrea.com", "custom_domain": true }],

  // Binding with no id: `wrangler deploy` provisions the namespace and
  // writes the id back here. Or create one yourself and add "id".
  "kv_namespaces": [{ "binding": "LINKS" }],

  "vars": {
    // Public base used to build `shortUrl` in API responses.
    "SHORT_BASE_URL": "https://go.lfcrea.com",
    // Comma-separated browser origins allowed to call /api/*. This is the
    // Chrome extension on branch claude/links-extension (its id is fixed by
    // the "key" in its manifest.json). The wacrm server calls the API
    // server-side, so it does not need to be listed.
    "ALLOWED_ORIGINS": "chrome-extension://bfdicajogngofgmdnilbhmpliocicbpi",
    // Google sign-in ("LF ID"): the LF Creative Supabase project. Public values, not secrets.
    // Empty SUPABASE_URL turns sign-in off and leaves only the API key.
    "SUPABASE_URL": "https://vxgtywdqijtfnkgyubkh.supabase.co",
    // The project's publishable key. Only used to ask the Auth server to check tokens signed
    // with the legacy shared secret (HS256); harmless if the project uses asymmetric keys.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_SiacCN613xiw-7RZvtt1wg__R0Zte_u",
    // Only Google accounts on this email domain are let in.
    "ALLOWED_EMAIL_DOMAIN": "lfcrea.com"
  },

  // Counts wrong PIN guesses for PIN-locked links with strong consistency
  // (KV cannot). One PinGuard object per lock; see src/guard.ts.
  "durable_objects": { "bindings": [{ "name": "PIN_GUARD", "class_name": "PinGuard" }] },
  "exports": { "PinGuard": { "type": "durable-object", "storage": "sqlite" } }

  // Secrets (set in the dashboard or with `wrangler secret put`, see README):
  //   API_KEY     required. Until it exists every /api/* call returns 500.
  //   PIN_SECRET  needed for PIN locks. Without it, setting a PIN returns 503 and
  //               locked links stay closed (they never redirect).
}
